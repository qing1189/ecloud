# eCloud Web 服务 - Docker 多阶段构建
# 适用环境：中国大陆服务器（使用国内镜像加速）

# 阶段 1：前端构建
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# 复制前端项目文件
COPY web/package*.json ./

# 使用国内 npm 镜像加速
RUN npm config set registry https://registry.npmmirror.com && \
    npm install

# 复制前端源代码
COPY web/ .

# 构建前端（输出到 ./dist）
RUN npm run build -- --outDir=./dist

# 阶段 2：后端构建
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app

# 先复制所有代码（包括前端构建产物）
COPY . .
COPY --from=frontend-builder /app/dist ./static

# 设置环境变量
ENV GO111MODULE=on

# 使用 ecloud 代理下载 SDK
RUN go env -w GOPROXY=https://ecloud.10086.cn/api/query/developer/nexus/repository/go-sdk/ && \
    go env -w GONOSUMDB=gitlab.ecloud.com && \
    go get -u gitlab.ecloud.com/ecloud/ecloudsdkcomputer

# 切换到公共代理并构建
RUN go env -w GOPROXY=https://goproxy.cn,direct && \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o ecloud .

# 阶段 3：最终运行镜像
FROM alpine:latest

# 使用国内 Alpine 镜像源加速
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk --no-cache add ca-certificates tzdata wget

# 设置时区
ENV TZ=Asia/Shanghai

WORKDIR /app

# 从构建阶段复制二进制文件和静态资源
COPY --from=backend-builder /app/ecloud .
COPY --from=backend-builder /app/static ./static

# 创建存储目录
RUN mkdir -p /app/store

# 暴露端口
EXPOSE 8088

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8088/health || exit 1

# 启动服务
CMD ["./ecloud", "server"]
