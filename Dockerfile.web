# 多阶段构建 Dockerfile
# 阶段 1：构建前端
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# 复制前端依赖文件
COPY web/package*.json ./

# 使用国内 npm 镜像加速
RUN npm config set registry https://registry.npmmirror.com && \
    npm install

# 复制前端源代码
COPY web/ .

# 构建前端（输出到 ./dist）
RUN npm run build -- --outDir=./dist

# 阶段 2：构建后端
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app

# 安装 CGO 依赖（SQLite 需要）
RUN apk add --no-cache gcc musl-dev

# 先只复制 go.mod 和 go.sum，利用 Docker 缓存
COPY go.mod go.sum ./

# 设置环境变量
ENV GO111MODULE=on
ENV GONOSUMDB=gitlab.ecloud.com

# 使用 ecloud 代理下载 SDK（允许部分失败）
RUN go env -w GOPROXY=https://ecloud.10086.cn/api/query/developer/nexus/repository/go-sdk/,https://goproxy.cn,direct && \
    (go get -u gitlab.ecloud.com/ecloud/ecloudsdkcomputer || true) && \
    (go get -u gitlab.ecloud.com/ecloud/ecloudsdkcore || true)

# 下载其他依赖
RUN go mod download

# 复制所有代码
COPY . .

# 复制前端构建产物
COPY --from=frontend-builder /app/dist ./static

# 构建后端（启用 CGO 支持 SQLite，使用已下载的依赖）
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags '-linkmode external -extldflags "-static"' -o ecloud .

# 阶段 3：最终运行镜像
FROM alpine:latest

# 使用国内 Alpine 镜像源加速
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk --no-cache add ca-certificates tzdata wget

# 设置时区
ENV TZ=Asia/Shanghai

WORKDIR /app

# 从构建阶段复制二进制文件和静态资源
COPY --from=backend-builder /app/ecloud .
COPY --from=backend-builder /app/static ./static

# 创建数据目录（SQLite 存放位置）
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 8088

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8088/health || exit 1

# 启动服务
CMD ["./ecloud", "server"]
