# eCloud Web 管理界面 - 环境变量配置

# ============================================
# 服务配置
# ============================================

# Web 服务端口
WEB_PORT=8088

# 时区设置
TZ=Asia/Shanghai

# 日志级别：debug, info, warning, error
LOG_LEVEL=info

# ============================================
# 管理员账号配置（首次启动时使用）
# ============================================

# 管理员用户名（默认：admin）
ADMIN_USERNAME=admin

# 管理员密码（默认：admin123456）
# ⚠️ 生产环境请务必修改为强密码！
# 建议：至少12位，包含大小写字母、数字、特殊字符
ADMIN_PASSWORD=admin123456

# ============================================
# 数据存储配置
# ============================================

# 数据目录（宿主机路径）
# Docker 会将此目录挂载到容器内的 /app/data，存放 ecloud.db 文件
DATA_DIR=./data

# ============================================
# 可选配置
# ============================================

# 是否启用调试模式（启用后日志级别会被覆盖为 debug）
# DEBUG=false

# 健康检查间隔（秒）
# HEALTHCHECK_INTERVAL=30

# ============================================
# 部署环境
# ============================================

# 部署环境标识：development, staging, production
DEPLOY_ENV=production

# ============================================
# 备份配置（建议定期备份）
# ============================================

# 备份目录
BACKUP_DIR=./backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ============================================
# 注意事项
# ============================================

# 1. 首次启动密码来源：ADMIN_PASSWORD 环境变量（默认：admin123456）
# 2. 管理员密码使用 bcrypt 加密存储在 SQLite 数据库
# 3. 首次启动后，修改 .env 中的 ADMIN_PASSWORD 不会影响已创建的管理员账号
# 4. 如需重置密码，请登录后台或删除 ecloud.db 重新初始化
# 5. 建议定期备份 data/ecloud.db 文件
# 6. 公众版账号添加时会自动弹出验证码对话框进行设备信任

# ============================================
# 安全建议
# ============================================

# ⚠️ 生产环境请设置强密码！
# 1. 密码至少 12 位，包含大小写字母、数字、特殊字符
# 2. 不要将 .env 文件提交到版本控制系统
# 3. 使用 Nginx 反向代理并配置 HTTPS
# 4. 配置防火墙规则限制访问 IP
# 5. 定期备份数据目录
