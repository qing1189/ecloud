# eCloud Web 管理界面 - 环境变量配置

# ============================================
# 服务配置
# ============================================

# Web 服务端口
WEB_PORT=8088

# 时区设置
TZ=Asia/Shanghai

# 日志级别：debug, info, warning, error
LOG_LEVEL=info

# ============================================
# 数据存储配置
# ============================================

# 数据目录（宿主机路径）
# Docker 会将此目录挂载到容器内的 /app/store
DATA_DIR=./data/store

# ============================================
# 可选配置
# ============================================

# 是否启用调试模式（启用后日志级别会被覆盖为 debug）
# DEBUG=false

# 健康检查间隔（秒）
# HEALTHCHECK_INTERVAL=30

# ============================================
# 部署环境
# ============================================

# 部署环境标识：development, staging, production
DEPLOY_ENV=production

# ============================================
# 备份配置（建议定期备份）
# ============================================

# 备份目录
BACKUP_DIR=./backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ============================================
# 注意事项
# ============================================

# 1. 首次启动后会在控制台显示管理员密码，请妥善保存
# 2. 账号密码存储在 data/store/accounts.json（Base64 编码）
# 3. 管理员密码存储在 data/store/auth.json（哈希后）
# 4. 操作日志存储在 data/store/logs.json
# 5. 建议定期备份 data/store 目录
# 6. 公众版账号需要先在本地运行 trust 命令进行设备信任

# ============================================
# 安全建议
# ============================================

# 1. 生产环境请修改默认端口
# 2. 使用 Nginx 反向代理并配置 HTTPS
# 3. 配置防火墙规则限制访问 IP
# 4. 定期备份数据目录
# 5. 首次登录后立即修改密码
